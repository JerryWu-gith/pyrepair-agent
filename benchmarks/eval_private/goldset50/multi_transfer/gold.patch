+"""Coordinate ledger operations and return transfer receipts."""
+
+
+class TransferService:
+    def __init__(self, ledger):
+        self.ledger = ledger
+        self._completed = {}
+
+    def transfer(self, request_id, source, destination, amount):
+        payload = (source, destination, amount)
+        if request_id in self._completed:
+            previous, receipt = self._completed[request_id]
+            if previous != payload or type(amount) is not int:
+                raise ValueError("request ID already used for a different payload")
+            return receipt
+        self.ledger.validate_transfer(source, destination, amount)
+        self.ledger.debit(source, amount)
+        self.ledger.credit(destination, amount)
+        receipt = (request_id, source, destination, amount)
+        self._completed[request_id] = (payload, receipt)
+        return receipt
